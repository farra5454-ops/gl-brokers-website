# ============================================================
# GL Insurance Brokers — Cloudflare Pages headers
#
# NOTE ON THE CSP BELOW:
# Google Analytics and Microsoft Clarity are explicitly allow-listed.
# If you ever add another third-party script (chat widget, ad pixel,
# call-tracking service), it will be SILENTLY BLOCKED until its domain
# is added here. Symptom: the tool collects nothing while appearing
# installed. Check the browser console for "Content Security Policy".
# ============================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=3600, stale-while-revalidate=86400
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com; media-src 'self'; connect-src 'self' https://formspree.io https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.clarity.ms https://c.bing.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# ------------------------------------------------------------
# Caching
#
# Cloudflare Pages purges its edge cache on every new deployment, so a
# long s-maxage (edge) is safe — a deploy always busts it. The browser
# max-age is kept short because filenames are not content-hashed, so a
# returning visitor must be able to pick up CSS/JS changes quickly.
# ------------------------------------------------------------

# Images. NOTE: `immutable` was removed deliberately — it tells browsers never
# to revalidate, so replacing a photo under the same filename would leave
# returning visitors on the old one for a month with no way to fix it (a
# Cloudflare purge clears the edge, not their browser). One day in the browser,
# one year at the edge; a deploy or purge handles the edge side.
/assets/images/*
  Cache-Control: public, max-age=86400, s-maxage=31536000

# Stylesheets and scripts.
#
# IMPORTANT — s-maxage is deliberately SHORT (10 min) on these two.
# An earlier version used s-maxage=2592000 (30 days) on the assumption that
# Cloudflare Pages purges its edge cache on every deploy. It does NOT.
# The result: analytics.js was uploaded with a live GA4 ID but the edge kept
# serving the old empty-ID copy, so tracking silently did nothing.
#
# Do not raise these values unless you are willing to hit "Purge Everything"
# in the Cloudflare dashboard after every single deploy. Filenames here are
# not content-hashed, so the cache has no other way to know they changed.
#
# stale-while-revalidate keeps things fast: after the 10 minutes the edge
# still serves instantly while fetching the new copy in the background.
/assets/css/*
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=600, s-maxage=600, stale-while-revalidate=86400

# Video — same reasoning as images above. The hero video is the most likely
# asset to be re-cut and re-uploaded under the same filename.
/assets/video/*
  Cache-Control: public, max-age=86400, s-maxage=31536000

# Fonts / icons
/favicon.ico
  Cache-Control: public, max-age=604800, s-maxage=2592000

# Crawler files — keep these fresh so sitemap changes are picked up fast.
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=3600

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=3600
